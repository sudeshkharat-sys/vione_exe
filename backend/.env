# Database (Postgres for production, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./data/ai_vision.db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models

# Models
GROUNDING_DINO_PATH=../datavision_hf_models/grounding-dino-base
SAM2_PATH=../datavision_hf_models/sam2-hiera-large
SIGLIP_PATH=../datavision_hf_models/siglip-so400m-patch14-384

# Training Defaults
SEED_LEARNING_RATE=0.0005
